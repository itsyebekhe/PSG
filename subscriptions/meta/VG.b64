mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
proxies:
  - {"name": "🇻🇬 VG | VLESS | @dailyv2ray #1 [fast]", "server": "mtn.ircf.space", "port": 2096, "type": "vless", "skip-cert-verify": true, "uuid": "7f64eeb1-b5f1-40a0-d80e-e6c718f6bd6a", "network": "tcp", "tls": false, "udp": true, "client-fingerprint": "chrome"}
proxy-groups:
  - name: "PROXY"
    type: select
    proxies:
      - '🇻🇬 VG | VLESS | @dailyv2ray #1 [fast]'
      - DIRECT
  - name: "Auto"
    type: url-test
    proxies:
      - '🇻🇬 VG | VLESS | @dailyv2ray #1 [fast]'
rules:
