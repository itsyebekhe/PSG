mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
proxies:
  - {"name": "🇨🇭 CH | VLESS | @hope_net #1 [fast]", "server": "185.18.250.109", "port": 443, "type": "vless", "skip-cert-verify": true, "uuid": "2cd6ed0f-636e-4e6c-9449-5a263d7a0fa5", "network": "tcp", "tls": false, "udp": true, "client-fingerprint": "chrome"}
proxy-groups:
  - name: "PROXY"
    type: select
    proxies:
      - '🇨🇭 CH | VLESS | @hope_net #1 [fast]'
      - DIRECT
  - name: "Auto"
    type: url-test
    proxies:
      - '🇨🇭 CH | VLESS | @hope_net #1 [fast]'
rules:
  - GEOIP,IR,DIRECT
  - MATCH,PROXY
